    <recordUpdates>
        <name>Update_Existing_Creator_Access</name>
        <label>Update Existing Creator Access</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Creator_Access_Updation_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
